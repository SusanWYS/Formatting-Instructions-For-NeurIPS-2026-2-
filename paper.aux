\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces For \textbf  {RQ2a}, this experiment tests whether causal and temporal CAA directions distinguish their own relation and transfer to the other relation. Rows identify the CAA training set, columns identify the in-distribution evaluation set, and cells report paired accuracy; diagonal cells measure same-relation discrimination and off-diagonal cells measure cross-transfer. \textbf  {Main takeaway: strong diagonals and weaker cross-transfer indicate that causal and temporal directions are partly relation-selective.}}}{2}{figure.2}\protected@file@percent }
\newlabel{fig:rq2-ct}{{2}{2}{For \textbf {RQ2a}, this experiment tests whether causal and temporal CAA directions distinguish their own relation and transfer to the other relation. Rows identify the CAA training set, columns identify the in-distribution evaluation set, and cells report paired accuracy; diagonal cells measure same-relation discrimination and off-diagonal cells measure cross-transfer. \textbf {Main takeaway: strong diagonals and weaker cross-transfer indicate that causal and temporal directions are partly relation-selective.}}{figure.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces For \textbf  {RQ2a}, this experiment tests whether causal and plausibility CAA directions distinguish their own relation and transfer to the other relation. Rows identify the CAA training set, columns identify the in-distribution evaluation set, and cells report paired accuracy for each model; plausibility estimates are exploratory because they use only 14 evaluation pairs. \textbf  {Main takeaway: high same-relation accuracy and weaker cross-transfer suggest that causal representations are not reducible to event plausibility.}}}{2}{figure.3}\protected@file@percent }
\newlabel{fig:rq2-cp}{{3}{2}{For \textbf {RQ2a}, this experiment tests whether causal and plausibility CAA directions distinguish their own relation and transfer to the other relation. Rows identify the CAA training set, columns identify the in-distribution evaluation set, and cells report paired accuracy for each model; plausibility estimates are exploratory because they use only 14 evaluation pairs. \textbf {Main takeaway: high same-relation accuracy and weaker cross-transfer suggest that causal representations are not reducible to event plausibility.}}{figure.3}{}}
