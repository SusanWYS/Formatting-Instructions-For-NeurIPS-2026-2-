\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces For \textbf  {RQ2b}, this experiment compares causal, temporal, and plausibility CAA directions on the same 150 unseen causal pairs. Bars show paired accuracy with Wilson 95\% CIs; the dashed line marks chance. \textbf  {Main takeaway: the causal direction generalizes most consistently, indicating that its performance is not explained by temporal or plausibility information alone.}}}{3}{figure.4}\protected@file@percent }
\newlabel{fig:rq2b}{{4}{3}{For \textbf {RQ2b}, this experiment compares causal, temporal, and plausibility CAA directions on the same 150 unseen causal pairs. Bars show paired accuracy with Wilson 95\% CIs; the dashed line marks chance. \textbf {Main takeaway: the causal direction generalizes most consistently, indicating that its performance is not explained by temporal or plausibility information alone.}}{figure.4}{}}
