\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Differences from the matched white-male condition for positive and negative outcomes, measured by training-gap-normalized causal projection (left) and expected Likert rating (right). Bars show equal-weight means across seven models with 95\% scenario-bootstrap CIs; green and coral dashed lines give the corresponding neutral-baseline-minus-white-male differences, and solid gray lines mark zero. \textbf  {Positive-outcome CAA projections increase across demographic conditions, while minority women exceed white men in both negative-outcome measures.}}}{6}{figure.caption.14}\protected@file@percent }
\newlabel{fig:naturalistic-aggregate}{{5}{6}{Differences from the matched white-male condition for positive and negative outcomes, measured by training-gap-normalized causal projection (left) and expected Likert rating (right). Bars show equal-weight means across seven models with 95\% scenario-bootstrap CIs; green and coral dashed lines give the corresponding neutral-baseline-minus-white-male differences, and solid gray lines mark zero. \textbf {Positive-outcome CAA projections increase across demographic conditions, while minority women exceed white men in both negative-outcome measures.}}{figure.caption.14}{}}
