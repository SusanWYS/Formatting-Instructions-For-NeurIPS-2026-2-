\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces Change in Llama~3.1 70B paired accuracy when intervening at layer 36 with the causal direction or ten norm-matched random directions. Points show mean changes, and the error bars use the procedure in Appendix~\ref {app:confidence-intervals}. Negative values indicate reduced discrimination between critical and control contexts. \textbf  {At this deeper layer, the causal intervention produces a large monotonic decrease in accuracy, whereas the random-direction mean remains near zero.}}}{18}{figure.caption.43}\protected@file@percent }
\newlabel{fig:llama70b-layer36-intervention}{{10}{18}{Change in Llama~3.1 70B paired accuracy when intervening at layer 36 with the causal direction or ten norm-matched random directions. Points show mean changes, and the error bars use the procedure in Appendix~\ref {app:confidence-intervals}. Negative values indicate reduced discrimination between critical and control contexts. \textbf {At this deeper layer, the causal intervention produces a large monotonic decrease in accuracy, whereas the random-direction mean remains near zero.}}{figure.caption.43}{}}
