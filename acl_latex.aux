\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Differences from the matched white-male condition for positive and negative outcomes (columns), measured by training-gap-normalized causal projection (top row) and expected Likert rating (bottom row). Bars show equal-weight means across seven models. Appendix~\ref {app:confidence-intervals} describes the error bars. Olive and coral indicate positive and negative outcomes, respectively. Matching dashed lines give the corresponding non-demographic-baseline-minus-white-male differences, and solid gray lines mark zero. \textbf  {Positive-outcome CAA projections increase across demographic conditions, while minority women exceed white men in both negative-outcome measures.}}}{7}{figure.caption.17}\protected@file@percent }
\newlabel{fig:naturalistic-aggregate}{{5}{7}{Differences from the matched white-male condition for positive and negative outcomes (columns), measured by training-gap-normalized causal projection (top row) and expected Likert rating (bottom row). Bars show equal-weight means across seven models. Appendix~\ref {app:confidence-intervals} describes the error bars. Olive and coral indicate positive and negative outcomes, respectively. Matching dashed lines give the corresponding non-demographic-baseline-minus-white-male differences, and solid gray lines mark zero. \textbf {Positive-outcome CAA projections increase across demographic conditions, while minority women exceed white men in both negative-outcome measures.}}{figure.caption.17}{}}
