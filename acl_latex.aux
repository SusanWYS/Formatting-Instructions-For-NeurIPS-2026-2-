\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Cross-transfer paired accuracy between causal and occasional relations (top row) and causal and plausibility relations (bottom row). Within each heatmap, rows show the CAA training set and columns show the held-out in-distribution test set; plausibility accuracy is the unweighted macro-average over its three source test sets. \textbf  {Causal CAA directions are largely relation-selective with respect to the tested occasion and event-feasibility baselines.}}}{4}{figure.caption.6}\protected@file@percent }
\newlabel{fig:rq2-transfer}{{2}{4}{Cross-transfer paired accuracy between causal and occasional relations (top row) and causal and plausibility relations (bottom row). Within each heatmap, rows show the CAA training set and columns show the held-out in-distribution test set; plausibility accuracy is the unweighted macro-average over its three source test sets. \textbf {Causal CAA directions are largely relation-selective with respect to the tested occasion and event-feasibility baselines.}}{figure.caption.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Paired accuracy of causal, occasional, and plausibility CAA directions on 150 unseen within-sentence causal inference pairs with 95\% CIs. \textbf  {Causal CAA directions generalize consistently to within-sentence implicit causal inference.} Occasion and plausibility CAA directions transfer less consistently to within-sentence implicit causal items.}}{4}{figure.caption.7}\protected@file@percent }
\newlabel{fig:rq2b}{{3}{4}{Paired accuracy of causal, occasional, and plausibility CAA directions on 150 unseen within-sentence causal inference pairs with 95\% CIs. \textbf {Causal CAA directions generalize consistently to within-sentence implicit causal inference.} Occasion and plausibility CAA directions transfer less consistently to within-sentence implicit causal items}{figure.caption.7}{}}
