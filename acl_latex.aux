\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Change in paired accuracy across fixed intervention magnitudes $|\alpha |=1$--$5$ for the causal direction and ten norm-matched random directions. Points show mean changes, and Appendix~\ref {app:confidence-intervals} describes the error bars. Negative values indicate reduced discrimination between critical and control contexts. \textbf  {In five models, increasing the causal intervention increasingly reduces paired accuracy and generally has a larger effect than the random baseline. Qwen3 4B shows no reliable effect, while Llama~3.1 70B changes in the opposite direction.}}}{6}{figure.caption.13}\protected@file@percent }
\newlabel{fig:intervention-alpha-sweep}{{4}{6}{Change in paired accuracy across fixed intervention magnitudes $|\alpha |=1$--$5$ for the causal direction and ten norm-matched random directions. Points show mean changes, and Appendix~\ref {app:confidence-intervals} describes the error bars. Negative values indicate reduced discrimination between critical and control contexts. \textbf {In five models, increasing the causal intervention increasingly reduces paired accuracy and generally has a larger effect than the random baseline. Qwen3 4B shows no reliable effect, while Llama~3.1 70B changes in the opposite direction.}}{figure.caption.13}{}}
