\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Cross-transfer paired accuracy between causal and occasional relations (top row) and causal and plausibility relations (bottom row). Within each heatmap, rows show the relation used to construct the CAA and columns show the held-out in-distribution evaluation relation. Plausibility accuracy is the unweighted macro-average over its three sources. \textbf  {Causal CAA directions are largely relation-selective with respect to the tested occasion and event-feasibility baselines.}}}{5}{figure.caption.9}\protected@file@percent }
\newlabel{fig:rq2-transfer}{{2}{5}{Cross-transfer paired accuracy between causal and occasional relations (top row) and causal and plausibility relations (bottom row). Within each heatmap, rows show the relation used to construct the CAA and columns show the held-out in-distribution evaluation relation. Plausibility accuracy is the unweighted macro-average over its three sources. \textbf {Causal CAA directions are largely relation-selective with respect to the tested occasion and event-feasibility baselines.}}{figure.caption.9}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Paired accuracy of causal, occasional, and plausibility CAA directions on 150 unseen within-sentence causal inference pairs. Appendix~\ref {app:confidence-intervals} describes the error bars. \textbf  {Causal CAA directions generalize consistently to within-sentence implicit causal inference.} Occasion and plausibility CAA directions transfer less consistently to within-sentence implicit causal items.}}{5}{figure.caption.10}\protected@file@percent }
\newlabel{fig:rq2b}{{3}{5}{Paired accuracy of causal, occasional, and plausibility CAA directions on 150 unseen within-sentence causal inference pairs. Appendix~\ref {app:confidence-intervals} describes the error bars. \textbf {Causal CAA directions generalize consistently to within-sentence implicit causal inference.} Occasion and plausibility CAA directions transfer less consistently to within-sentence implicit causal items}{figure.caption.10}{}}
